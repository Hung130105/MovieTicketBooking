@model MovieTicketBooking.Models.Movie

@{
    ViewData["Title"] = "Thêm Phim Mới";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-success text-white text-center">
            <h4 class="mb-0"><i class="fas fa-film"></i> THÊM PHIM MỚI</h4>
        </div>

        <div class="card-body">

            <!-- ✅ Thông báo thành công / thất bại -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success text-center">@TempData["SuccessMessage"]</div>
            }
            else if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger text-center">@TempData["ErrorMessage"]</div>
            }

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <!-- ✅ Hiển thị lỗi tổng -->
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Tên phim *</label>
                    <input asp-for="Title" class="form-control" placeholder="Nhập tên phim..." />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Mô tả phim *</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Nhập mô tả phim..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ReleaseDate" class="form-label">Ngày khởi chiếu *</label>
                        <input asp-for="ReleaseDate" type="date" class="form-control" />
                        <span asp-validation-for="ReleaseDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="EndDate" class="form-label">Ngày kết thúc *</label>
                        <input asp-for="EndDate" type="date" class="form-control" />
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Duration" class="form-label">Thời lượng (phút) *</label>
                        <input asp-for="Duration" type="number" min="1" class="form-control" placeholder="VD: 120" />
                        <span asp-validation-for="Duration" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Genre" class="form-label">Thể loại *</label>
                        <input asp-for="Genre" class="form-control" placeholder="VD: Hành động, Hài..." />
                        <span asp-validation-for="Genre" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Language" class="form-label">Ngôn ngữ *</label>
                        <input asp-for="Language" class="form-control" placeholder="VD: Tiếng Việt, English..." />
                        <span asp-validation-for="Language" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Director" class="form-label">Đạo diễn *</label>
                        <input asp-for="Director" class="form-control" placeholder="Tên đạo diễn..." />
                        <span asp-validation-for="Director" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Cast" class="form-label">Diễn viên chính *</label>
                        <input asp-for="Cast" class="form-control" placeholder="Tên diễn viên..." />
                        <span asp-validation-for="Cast" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="form-label">Giá vé (VNĐ) *</label>
                    <input asp-for="Price" type="number" min="0" class="form-control" placeholder="VD: 90000" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Ảnh poster *</label>
                    <input type="file" name="PosterFile" class="form-control" accept="image/*" />
                    <small class="text-muted">Chỉ chọn file ảnh (.jpg, .png, .jpeg...)</small>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-plus-circle"></i> Thêm Phim
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
