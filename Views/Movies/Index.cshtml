@model IEnumerable<MovieTicketBooking.Models.Movie>

@{
    ViewData["Title"] = "Danh sách phim";
}

<div class="container mt-5">
    <h2 class="text-center text-primary mb-4 fw-bold">
        🎬 DANH SÁCH PHIM ĐANG CHIẾU
    </h2>

    <!-- 🔍 Thanh tìm kiếm và lọc -->
    <form asp-action="Index" method="get" class="row justify-content-center mb-4">
        <div class="col-md-4 mb-2">
            <input type="text" name="searchString" value="@ViewData["CurrentFilter"]"
                   class="form-control" placeholder="Nhập tên phim cần tìm..." />
        </div>
        <div class="col-md-3 mb-2">
            <select name="genreFilter" class="form-select">
                <option value="">-- Tất cả thể loại --</option>
                <option value="Hành động">Hành động</option>
                <option value="Hoạt hình">Hoạt hình</option>
                <option value="Tình cảm">Tình cảm</option>
                <option value="Khoa học viễn tưởng">Khoa học viễn tưởng</option>
                <option value="Hài">Hài</option>
                <option value="Kinh dị">Kinh dị</option>
            </select>
        </div>
        <div class="col-md-2 mb-2 text-center">
            <button type="submit" class="btn btn-outline-primary w-100">
                <i class="fas fa-search"></i> Tìm kiếm
            </button>
        </div>
    </form>

    <!-- 🎞️ Hiển thị danh sách phim -->
    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center mt-4">
            Không tìm thấy phim nào phù hợp với yêu cầu của bạn.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var movie in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                    <div class="card h-100 border-0 shadow-sm movie-card">
                        <img src="~/images/@movie.PosterUrl"
                             class="card-img-top rounded-top"
                             alt="@movie.Title"
                             style="height: 350px; object-fit: cover;" />

                        <div class="card-body text-center">
                            <h5 class="card-title text-truncate fw-bold">@movie.Title</h5>
                            <p class="text-muted small mb-1">@movie.Genre</p>
                            <p class="text-success fw-bold mb-2">
                                @String.Format("{0:N0} VNĐ", movie.Price)
                            </p>
                            <a asp-action="Details"
                               asp-route-id="@movie.Id"
                               class="btn btn-primary btn-sm px-3">
                                <i class="fas fa-ticket-alt"></i> Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Styles {
    <style>
        .movie-card:hover {
            transform: translateY(-5px);
            transition: 0.3s ease;
            box-shadow: 0 5px 20px rgba(0,0,0,0.2);
        }
    </style>
}
